---
// Top nav: name on the left, links + live clock on the right
---

<nav class="nav">
  <span class="nav-name">JANAE PARK</span>
  <div class="nav-links">
    <a href="#work">work</a>
    <a href="#contact">contact</a>
    <span class="clock" id="clock">--:--:-- CT</span>
  </div>
</nav>

<script>
  // Live clock — updates every second, shows Central time
  function updateClock() {
    const el = document.getElementById('clock');
    if (!el) return;
    const time = new Date().toLocaleTimeString('en-US', {
      hour12: false,
      timeZone: 'America/Chicago',
    });
    el.textContent = `${time} CT`;
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    margin-bottom: 5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .nav-name {
    color: var(--text-primary);
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-muted);
  }

  .clock {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    .nav-links {
      gap: 0.85rem;
    }
  }
</style>
