---
// Top nav: live clock only
---

<nav class="nav">
  <span class="clock" id="clock">--:--:-- CT</span>
</nav>

<script>
  // Live clock — updates every second, shows Central time
  function updateClock() {
    const el = document.getElementById('clock');
    if (!el) return;
    const time = new Date().toLocaleTimeString('en-US', {
      hour12: false,
      timeZone: 'America/Chicago',
    });
    el.textContent = `${time} CT`;
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>

<style>
  .nav {
    display: flex;
    justify-content: flex-end;
    padding-bottom: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
  }

  .clock {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
