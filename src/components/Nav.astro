---
// Top nav: live clock only
---

<nav class="nav">
  <span class="clock" id="clock">--:--:-- CT</span>
</nav>

<script>
  // Live clock — updates every second, uses user's local time & device preferences
  function updateClock() {
    const el = document.getElementById('clock');
    if (!el) return;

    const now = new Date();

    const time = now.toLocaleTimeString(undefined, {
      hour: 'numeric',
      minute: '2-digit',
      second: '2-digit',
      // no hour12 → lets device decide (better for mobile + international users)
    });

    el.textContent = time;
  }

  // Run only in browser (Astro-safe)
  if (typeof window !== 'undefined') {
    updateClock();
    setInterval(updateClock, 1000);
  }
</script>

<style>
  .nav {
    display: flex;
    justify-content: flex-end;
    padding-bottom: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
  }

  .clock {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
