---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import Waveform from '../components/Waveform.astro';
---

<Layout>
  <main class="page">
    <Nav />

    <!-- 01 / INTRO -->
    <Section label="01 / INTRO">
      <h1 class="hero-name">Janae Park</h1>
      <p class="hero-tagline">
        Frontend developer currently building features for an investment app.
        Focused on accessible, secure interfaces.
      </p>
      <Waveform />
    </Section>

    <!-- 02 / WORK -->
    <Section label="02 / WORK" id="work">
      <div class="work-company">
        <span class="work-name">PNC</span>
        <span class="work-dates">2024 — present</span>
      </div>
      <div class="role-row">
        <span class="role-title">Software Engineer</span>
        <span class="role-date">2025 — present</span>
      </div>
      <div class="role-row role-row-prev">
        <span class="role-title">Technology Development Associate</span>
        <span class="role-date">2024 — 2025</span>
      </div>
    </Section>

    <!-- 03 / FREE TIME (number-only label, sentence flows) -->
    <Section label="03">
      <p class="freetime">
        <span class="freetime-lead">In my free time.</span>
        Running, lifting, reading, or chasing a good set somewhere.
      </p>
    </Section>

    <!-- 04 / NOW PLAYING -->
    <Section label="04 / NOW PLAYING">
      <div class="spotify-wrapper">
        <!--
          Replace this iframe with your own Spotify embed.
          Get it from Spotify: open a playlist → ⋯ → Share → Embed playlist.
        -->
        <iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/playlist/7MCjjGTfVhmrANqsQbEpK4?utm_source=generator&theme=0" width="100%" height="352" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
       
      </div>
    </Section>

    <!-- 05 / CONTACT -->
    <Section label="05 / CONTACT" id="contact">
      <div class="contact-links">
        <a href="mailto:hello@janaepark.com">email</a>
        <a href="https://github.com/yourusername" target="_blank" rel="noopener">github</a>
        <a href="https://linkedin.com/in/janae-park" target="_blank" rel="noopener">linkedin</a>
      </div>
    </Section>
  </main>
</Layout>

<style>
  /* ===== Hero ===== */
  .hero-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.75rem, 6vw, 3.75rem);
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .hero-tagline {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 540px;
  }

  /* ===== Work ===== */
  .work-company {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .work-name {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .work-dates {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .role-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.55rem 0;
    font-size: 0.875rem;
  }

  .role-title {
    color: var(--text-body);
  }

  .role-row-prev .role-title {
    color: var(--text-muted);
  }

  .role-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  /* ===== Free time ===== */
  .freetime {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-body);
  }

  .freetime-lead {
    color: var(--text-dim);
  }

  /* ===== Spotify ===== */
  .spotify-wrapper {
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-elev);
    border: 0.5px solid var(--border);
  }

  .spotify-wrapper iframe {
    display: block;
    border: 0;
  }

  /* ===== Contact ===== */
  .contact-links {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .contact-links a {
    color: var(--text-body);
  }
</style>
