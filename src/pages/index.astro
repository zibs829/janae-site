---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import Waveform from '../components/Waveform.astro';
---

<Layout>
  <main class="page">
    <Nav />

    <!-- 01 / INTRO -->
    <Section label="01 / INTRO">
      <h1 class="hero-name">Janae Park</h1>
      <p class="hero-tagline">
        Frontend developer currently building features for an investment app.
        Focused on accessible, secure interfaces.
      </p>
      <div class="hero-icons">
        <div class="email-wrapper">
          <button class="email-trigger" aria-label="Email" aria-expanded="false" aria-haspopup="menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 6 10-6"/>
            </svg>
          </button>
          <div class="email-popover" role="menu" hidden>
            <a href="https://mail.google.com/mail/?view=cm&to=hello@janaepark.com" target="_blank" rel="noopener" role="menuitem">Gmail</a>
            <a href="https://outlook.live.com/mail/0/deeplink/compose?to=hello@janaepark.com" target="_blank" rel="noopener" role="menuitem">Outlook</a>
            <button class="copy-btn" role="menuitem" data-email="hello@janaepark.com">Copy address</button>
          </div>
        </div>
        <a href="https://github.com/zibs829" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
        </a>
        <a href="https://linkedin.com/in/janae-park" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
      </div>
      <Waveform />
    </Section>

    <!-- 02 / WORK -->
    <Section label="02 / Work" id="work">
      <div class="work-entry">
        <div class="work-title">Software Engineer at PNC</div>
        <div class="work-date">2025 — present</div>
      </div>
      <div class="work-entry work-entry-prev">
        <div class="work-title">Technology Development Associate at PNC</div>
        <div class="work-date">2024 — 2025</div>
      </div>
    </Section>

    <!-- 03 / FREE TIME -->
    <Section label="03">
      <p class="freetime">
        <span class="freetime-lead">In my free time.</span>
        Running, lifting, reading, or chasing a good set somewhere.
      </p>
    </Section>

    <!-- 04 / The Bass-ment -->
    <Section label="04 / The Bass-ment">
      <div class="spotify-wrapper">
        <iframe
          data-testid="embed-iframe"
          style="border-radius:12px"
          src="https://open.spotify.com/embed/playlist/7MCjjGTfVhmrANqsQbEpK4?utm_source=generator&theme=0"
          width="100%"
          height="352"
          frameBorder="0"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </Section>

  </main>
</Layout>

<style>
  /* ===== Hero ===== */
  .hero-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.75rem, 6vw, 3.75rem);
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .hero-tagline {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 1.75rem;
  }

  /* ===== Hero icons ===== */
  .hero-icons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .hero-icons > a {
    color: var(--text-muted);
    display: flex;
    transition: color 200ms ease;
  }

  .hero-icons > a:hover {
    color: var(--accent);
  }

  /* ===== Email popover ===== */
  .email-wrapper {
    position: relative;
    display: flex;
  }

  .email-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--text-muted);
    display: flex;
    transition: color 200ms ease;
  }

  .email-trigger:hover,
  .email-trigger[aria-expanded="true"] {
    color: var(--accent);
  }

  .email-popover {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-elev);
    border: 0.5px solid var(--border);
    border-radius: 6px;
    padding: 0.35rem 0;
    min-width: 130px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    z-index: 10;
  }

  .email-popover[hidden] {
    display: none;
  }

  .email-popover a,
  .email-popover .copy-btn {
    display: block;
    width: 100%;
    padding: 0.4rem 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    transition: color 200ms ease;
  }

  .email-popover a:hover,
  .email-popover .copy-btn:hover {
    color: var(--accent);
  }

  /* ===== Work ===== */
  .work-entry {
    margin-bottom: 1.25rem;
  }

  .work-title {
    font-size: 1rem;
    color: var(--text-body);
  }

  .work-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-top: 0.25rem;
  }

  .work-entry-prev .work-title {
    color: var(--text-muted);
  }

  /* ===== Free time ===== */
  .freetime {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-body);
    max-width: 480px;
    margin: 0 auto;
  }

  .freetime-lead {
    color: var(--text-dim);
  }

  /* ===== Spotify ===== */
  .spotify-wrapper {
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-elev);
    border: 0.5px solid var(--border);
  }

  .spotify-wrapper iframe {
    display: block;
    border: 0;
  }
</style>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('.email-trigger');
  const popover = document.querySelector<HTMLElement>('.email-popover');
  const copyBtn = document.querySelector<HTMLButtonElement>('.copy-btn');

  function close() {
    popover!.hidden = true;
    trigger!.setAttribute('aria-expanded', 'false');
  }

  trigger!.addEventListener('click', (e) => {
    e.stopPropagation();
    const opening = popover!.hidden;
    popover!.hidden = !opening;
    trigger!.setAttribute('aria-expanded', String(opening));
  });

  document.addEventListener('click', (e) => {
    if (!trigger!.contains(e.target as Node) && !popover!.contains(e.target as Node)) {
      close();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  copyBtn!.addEventListener('click', async () => {
    await navigator.clipboard.writeText(copyBtn!.dataset.email!);
    copyBtn!.textContent = 'Copied!';
    setTimeout(() => { copyBtn!.textContent = 'Copy address'; }, 1500);
    close();
  });
</script>
